    "test:jest:coverage": "jest --verbose --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "cors": "^2.8.6",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "jest": "^29.7.0"
  }
}
