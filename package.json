{
  "name": "arrivio-web-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unit tests for Arrivio Operator and Admin panels",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
